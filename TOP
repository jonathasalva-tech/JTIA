    return ok


def _print_plan(plan: InstallPlan, *, cuda: bool, browsers: bool, wake: bool) -> None:
    print("    Arquivos de requisitos:")
    if plan.requirement_files:
        for path in plan.requirement_files:
            print(f"      - {_rel(path)}")
    else:
        print("      - nenhum (será usada a lista embutida)")

    extras = [
        (base, spec)
        for base, spec in sorted(plan.packages.items())
        if base not in plan.covered_by_requirements
    ]
    covered = [
        (base, spec)
        for base, spec in sorted(plan.packages.items())
        if base in plan.covered_by_requirements
    ]
    print(f"    Comandos pip reconhecidos fora dos requirements ({len(extras)}):")
    if extras:
        for base, spec in extras:
            sources = ", ".join(plan.package_sources.get(base, []))
            print(f"      - {spec}   [{sources}]")
    else:
        print("      - nenhum pacote adicional")
    print(f"    Comandos pip já cobertos por requirements ({len(covered)}).")

    print("    Projetos editáveis:")
    if plan.editables:
        for path, source in plan.editables.items():
            extra = "[all]" if _has_extra(path, "all") else ""
            print(f"      - pip install -e {_rel(path)}{extra}   [{source}]")
    else:
        print("      - nenhum")

    print("    npm:")
    if plan.npm_prefixes:
        for path, source in plan.npm_prefixes.items():
            print(f"      - npm install --prefix {_rel(path)}   [{source}]")
    else:
        print("      - nenhum")

    if plan.indexed:
        action = "será instalado (--cuda)" if cuda else "adiado; use --cuda"
        for spec, url, source in plan.indexed:
            print(f"    CUDA: pip install {spec} --index-url {url}   [{source}] — {action}")

    if browsers:
        print("    Navegadores: playwright install chromium firefox")
    if wake:
        print("    Modelos: openwakeword download hey_jarvis")


