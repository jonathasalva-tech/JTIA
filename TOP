def _print_header(title: str) -> None:
    sep = "=" * 64
    print(f"\n{sep}\n  {title}\n{sep}")


def _print_step(num: int, total: int, msg: str) -> None:
    print(f"\n[{num}/{total}] ▶ {msg}")


def _rel(path: Path) -> str:
    try:
        return path.resolve().relative_to(HERE).as_posix()
    except (ValueError, OSError):
        return str(path)


def _inside_project(path: Path) -> bool:
    try:
        path.resolve().relative_to(HERE)
        return True
    except (ValueError, OSError):
        return False


def _skipped(path: Path) -> bool:
    try:
        parts = path.resolve().relative_to(HERE).parts
    except (ValueError, OSError):
        return True
    return any(part in _SKIP_DIR_NAMES or part.startswith(".") for part in parts[:-1])


def _base_name(spec: str) -> str:
    token = spec.strip().strip("'\"")
    return re.split(r"[\[<>=!~;\s]", token, maxsplit=1)[0].lower()


def _spec_score(spec: str) -> tuple:
    return (
        any(op in spec for op in (">=", "<=", "==", "~=", "!=", ">", "<")),
        "[" in spec,
        len(spec),
    )


def _windows_only(spec: str) -> bool:
    base = _base_name(spec)
    return base in _WINDOWS_ONLY or base.startswith("winrt-")


def _placeholder(token: str) -> bool:
    """Ignora trechos dinâmicos (`{pacote}`, `%s`, `<nome>`), sem confundir com `>=0.9`."""
    if any(mark in token for mark in ("{", "}", "%s", "%(", "$")):
        return True
    return token.startswith("<") or token.endswith(">")


def _run(label: str, args: list[str], cwd: Path | None = None, fatal: bool = True) -> bool:
    """Executa um comando de terminal exibindo status claro."""
    print(f"    * Executando: {label}...")
    try:
        res = subprocess.run(args, cwd=str(cwd or HERE), check=fatal)
        if res.returncode == 0:
            print(f"      [OK] {label}")
            return True
        print(f"      [AVISO] {label} encerrou com código {res.returncode}.")
        return False
    except subprocess.CalledProcessError as exc:
        print(f"      [FALHA] Erro ao executar {label}: {exc}")
        if fatal:
            raise
        return False
    except Exception as exc:
        print(f"      [AVISO] Não foi possível executar {label}: {exc}")
        if fatal:
            raise
        return False


