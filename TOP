def _tokenize(args: str) -> list[str]:
    try:
        tokens = shlex.split(args, posix=False)
    except ValueError:
        tokens = args.split()
    cleaned: list[str] = []
    for tok in tokens:
        if len(tok) >= 2 and tok[0] == tok[-1] and tok[0] in "\"'":
            tok = tok[1:-1]
        tok = tok.strip().strip("'\"")
        if tok:
            cleaned.append(tok)
    return cleaned


def _iter_source_files() -> list[Path]:
    files: list[Path] = []
    for name in _SCAN_FILES:
        path = HERE / name
        if path.is_file():
            files.append(path)
    for folder in _SCAN_DIRS:
        root = HERE / folder
        if not root.is_dir():
            continue
        for path in root.rglob("*.py"):
            if not path.is_file() or path.name.startswith("test_"):
                continue
            if _skipped(path):
                continue
            files.append(path)
    return files


def _resolve_requirement(token: str, origin: Path) -> Path | None:
    token = token.strip().strip("'\"")
    if not token or _placeholder(token):
        return None
    candidates = [origin.parent / token, HERE / token, HERE / "claude-overlay" / Path(token).name]
    for candidate in candidates:
        try:
            resolved = candidate.resolve()
        except OSError:
            continue
        if resolved.is_file() and _inside_project(resolved) and not _skipped(resolved):
            return resolved
    return None


def _resolve_editable(token: str) -> Path | None:
    raw = token.strip().strip("'\"")
    path_part = raw.split("[", 1)[0]
    path = Path(path_part)
    if not path.is_absolute():
        path = HERE / path
    try:
        resolved = path.resolve()
    except OSError:
        return None
    if not resolved.is_dir() or not _inside_project(resolved) or _skipped(resolved):
        return None
    if (resolved / "pyproject.toml").is_file() or (resolved / "setup.py").is_file() or (resolved / "setup.cfg").is_file():
        return resolved
    return None


def _has_extra(project: Path, extra: str) -> bool:
    toml = project / "pyproject.toml"
    if not toml.is_file():
        return False
    try:
        text = toml.read_text(encoding="utf-8")
    except OSError:
        return False
    return re.search(rf"(?m)^\s*{re.escape(extra)}\s*=\s*\[", text) is not None


def _runtime_installer_packages() -> list[tuple[str, str]]:
    """Pacotes que core/installer.py instala em tempo de execução."""
    try:
        if str(HERE) not in sys.path:
            sys.path.insert(0, str(HERE))
        from core import installer as runtime
    except Exception as exc:
        print(f"    [AVISO] Não foi possível ler core/installer.py: {exc}")
        return []
    found: list[tuple[str, str]] = []
    groups = [list(getattr(runtime, "_CORE", []))]
    if OS == "Windows":
        groups.append(list(getattr(runtime, "_WINDOWS", [])))
    for mapping_name in ("_STT", "_TTS"):
        mapping = getattr(runtime, mapping_name, {})
        if isinstance(mapping, dict):
            for pairs in mapping.values():
                groups.append(list(pairs))
    for pairs in groups:
        for item in pairs:
            if isinstance(item, tuple) and len(item) >= 2 and isinstance(item[1], str):
                found.append((item[1], "core/installer.py"))
    return found


class InstallPlan:
    """Tudo o que o código do aplicativo pede para instalar."""

    def __init__(self, *, allow_dev: bool = False) -> None:
        self.allow_dev = allow_dev
        self.requirement_files: list[Path] = []
        self.packages: dict[str, str] = {}
        self.package_sources: dict[str, list[str]] = {}
        self.indexed: list[tuple[str, str, str]] = []  # spec, url, source
        self.editables: dict[Path, str] = {}
        self.npm_prefixes: dict[Path, str] = {}
        self.covered_by_requirements: set[str] = set()

    def add_requirement(self, path: Path) -> None:
        resolved = path.resolve()
        if resolved.name == "requirements-dev.txt" and not self.allow_dev:
            return
        if resolved not in self.requirement_files:
            self.requirement_files.append(resolved)

    def add_package(self, spec: str, source: str) -> None:
        spec = spec.strip().strip("'\"")
        if not spec or _placeholder(spec) or not _PKG_RE.match(spec):
            return
        if _base_name(spec) in _LOCAL_MODULES:
            return
        if OS != "Windows" and _windows_only(spec):
            return
        base = _base_name(spec)
        current = self.packages.get(base)
        if current is None or _spec_score(spec) > _spec_score(current):
            self.packages[base] = spec
        self.package_sources.setdefault(base, [])
        if source not in self.package_sources[base]:
            self.package_sources[base].append(source)

    def add_indexed(self, spec: str, url: str, source: str) -> None:
        if not _PKG_RE.match(spec) or _placeholder(url):
            return
        self.indexed.append((spec, url, source))

    def add_editable(self, path: Path, source: str) -> None:
        self.editables.setdefault(path.resolve(), source)

    def add_npm(self, path: Path, source: str) -> None:
        self.npm_prefixes.setdefault(path.resolve(), source)


def _parse_pip_args(raw_args: str, origin: Path, source: str, plan: InstallPlan) -> None:
    index_url = ""
    batch: list[str] = []

    def flush() -> None:
        for spec in batch:
            if index_url:
                plan.add_indexed(spec, index_url, source)
            else:
                plan.add_package(spec, source)
        batch.clear()

    tokens = _tokenize(raw_args)
    i = 0
    while i < len(tokens):
        tok = tokens[i]
        if tok in ("-e", "--editable") and i + 1 < len(tokens):
            flush()
            editable = _resolve_editable(tokens[i + 1])
            if editable is not None:
                plan.add_editable(editable, source)
            i += 2
            continue
        if tok in ("-r", "--requirement") and i + 1 < len(tokens):
            flush()
            req = _resolve_requirement(tokens[i + 1], origin)
            if req is not None:
                plan.add_requirement(req)
            i += 2
            continue
        if tok.startswith("--index-url=") or tok.startswith("-i="):
            index_url = tok.split("=", 1)[1]
            i += 1
            continue
        if tok in _PIP_VALUE_FLAGS and i + 1 < len(tokens):
            if tok in ("--index-url", "-i"):
                index_url = tokens[i + 1]
            i += 2
            continue
        if tok.startswith("-"):
            i += 1
            continue
        if "/" in tok or "\\" in tok or tok.startswith("."):
            flush()
            editable = _resolve_editable(tok)
            if editable is not None:
                plan.add_editable(editable, source)
            i += 1
            continue
        batch.append(tok)
        i += 1
    flush()


def _parse_npm_args(raw_args: str, source: str, plan: InstallPlan) -> None:
    tokens = _tokenize(raw_args)
    prefix = ""
    i = 0
    while i < len(tokens):
        tok = tokens[i]
        if tok == "--prefix" and i + 1 < len(tokens):
            prefix = tokens[i + 1]
            i += 2
            continue
        if tok.startswith("--prefix="):
            prefix = tok.split("=", 1)[1]
            i += 1
            continue
        i += 1
    if not prefix:
        return
    path = Path(prefix)
    if not path.is_absolute():
        path = HERE / path
    try:
        resolved = path.resolve()
    except OSError:
        return
    if (
        resolved.is_dir()
        and _inside_project(resolved)
        and "node_modules" not in resolved.parts
        and (resolved / "package.json").is_file()
    ):
        plan.add_npm(resolved, source)


def _names_in_requirement(path: Path, seen: set[Path] | None = None) -> set[str]:
    seen = seen or set()
    try:
        resolved = path.resolve()
    except OSError:
        return set()
    if resolved in seen or not resolved.is_file():
        return set()
    seen.add(resolved)
    names: set[str] = set()
    try:
        lines = resolved.read_text(encoding="utf-8").splitlines()
    except OSError:
        return names
    for raw in lines:
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if line.startswith(("-r ", "--requirement ")):
            nested = _resolve_requirement(line.split(None, 1)[1], resolved)
            if nested is not None:
                names.update(_names_in_requirement(nested, seen))
            continue
        if line.startswith("-"):
            continue
        line = line.split(";", 1)[0].strip()
        base = _base_name(line)
        if base:
            names.add(base)
    return names


def discover_install_plan(*, include_dev: bool) -> InstallPlan:
    """Lê o código do aplicativo e monta a lista de tudo que precisa ser instalado."""
    plan = InstallPlan(allow_dev=include_dev)

    for path in _iter_source_files():
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        text = text.replace('\\"', " ").replace("\\'", " ").replace("\\n", " ").replace("\\t", " ")
        source = _rel(path)
        for match in _PIP_RE.finditer(text):
            _parse_pip_args(match.group("args"), path, source, plan)
        for match in _NPM_RE.finditer(text):
            _parse_npm_args(match.group("args"), source, plan)
        for match in _REQ_RE.finditer(text):
            req = _resolve_requirement(match.group(0), path)
            if req is not None:
                plan.add_requirement(req)

    for spec, source in _runtime_installer_packages():
        plan.add_package(spec, source)

    preferred = [
        HERE / "requirements.txt",
        HERE / "requirements-vision.txt",
        HERE / "requirements-media.txt",
        HERE / "requirements-docs.txt",
        HERE / "claude-overlay" / "requirements.txt",
        HERE / "claude-overlay" / "requirements-docs.txt",
    ]
    if include_dev:
        preferred.extend([
            HERE / "requirements-dev.txt",
            HERE / "claude-overlay" / "requirements-dev.txt",
        ])
    for path in preferred:
        if path.is_file():
            plan.add_requirement(path)
    for path in sorted(HERE.glob("requirements*.txt")):
        if path.name == "requirements-dev.txt" and not include_dev:
            continue
        plan.add_requirement(path)

    # Catálogo embutido entra só como rede de segurança dos mesmos recursos.
    for spec in ALL_PACKAGES:
        plan.add_package(spec, "setup.py (catálogo)")
    if OS == "Windows":
        for spec in WINDOWS_PACKAGES:
            plan.add_package(spec, "setup.py (catálogo Windows)")

    covered: set[str] = set()
    for path in plan.requirement_files:
        if path.name == "requirements-dev.txt" and not include_dev:
            continue
        covered.update(_names_in_requirement(path))
    plan.covered_by_requirements = covered
    return plan


def _install_requirement_files(files: list[Path]) -> tuple[int, list[str]]:
    """Instala cada requirements*.txt. O requirements.txt da raiz é obrigatório."""
    installed = 0
    failed: list[str] = []
    ordered = sorted(files, key=lambda p: (p.name != "requirements.txt", _rel(p)))
    for path in ordered:
        fatal = path.name == "requirements.txt" and path.parent == HERE
        ok = _run(
            f"Instalando pacotes de {_rel(path)}",
            [sys.executable, "-m", "pip", "install", "-r", str(path)],
            fatal=fatal,
        )
        if ok:
            installed += 1
        else:
            failed.append(_rel(path))
    return installed, failed


def _install_packages(packages: list[str], label: str) -> list[str]:
    if not packages:
        return []
    ok = _run(
        label,
        [sys.executable, "-m", "pip", "install", "--upgrade", *packages],
        fatal=False,
    )
    if ok:
        return []
    failed: list[str] = []
    for spec in packages:
        if not _run(
            f"Instalando {spec}",
            [sys.executable, "-m", "pip", "install", "--upgrade", spec],
            fatal=False,
        ):
            failed.append(spec)
    return failed


def _install_editables(plan: InstallPlan, enabled: bool) -> list[str]:
    if not enabled:
        print("    [INFO] Agent-Reach ignorado (--no-agent-reach).")
        return []
    if not plan.editables:
        # O código cita ./agent-reach; se o texto mudar, ainda procura a pasta.
        for name in ("agent-reach", "Agent-Reach", "agent_reach"):
            candidate = _resolve_editable(name)
            if candidate is not None:
                plan.add_editable(candidate, "setup.py (pasta local)")
                break
    if not plan.editables:
        print("    [INFO] Nenhum projeto local editável encontrado.")
        return []
    failed: list[str] = []
    for path, source in plan.editables.items():
        target = str(path)
        label = _rel(path)
        if _has_extra(path, "all"):
            target = f"{path}[all]"
            label = f"{_rel(path)}[all]"
            print(f"    [INFO] {source} pede a instalação editável; o extra 'all' inclui cookies, Playwright e MCP.")
        ok = _run(
            f"Instalando {label} em modo editável",
            [sys.executable, "-m", "pip", "install", "-e", target],
            fatal=False,
        )
        if not ok and target.endswith("[all]"):
            ok = _run(
                f"Instalando {_rel(path)} em modo editável",
                [sys.executable, "-m", "pip", "install", "-e", str(path)],
                fatal=False,
            )
        if not ok:
            failed.append(label)
    return failed


def _install_npm(plan: InstallPlan, enabled: bool) -> list[str]:
    if not enabled:
        print("    [INFO] npm ignorado (--no-npm).")
        return []
    if not plan.npm_prefixes:
        print("    [INFO] Nenhum comando npm de recurso do aplicativo foi encontrado.")
        return []
    npm = shutil.which("npm.cmd") or shutil.which("npm")
    if not npm:
        print("    [AVISO] Node.js/npm não está no PATH. Comandos reconhecidos e não executados:")
        for path, source in plan.npm_prefixes.items():
            print(f"           npm install --prefix {_rel(path)}   ({source})")
        return [f"npm:{_rel(path)}" for path in plan.npm_prefixes]
    failed: list[str] = []
    for path, source in plan.npm_prefixes.items():
        print(f"    [INFO] Comando reconhecido em {source}")
        ok = _run(
            f"npm install --prefix {_rel(path)}",
            [npm, "install", "--prefix", str(path)],
            fatal=False,
        )
        if not ok:
            failed.append(_rel(path))
    return failed


def _install_indexed(plan: InstallPlan, cuda: bool) -> list[str]:
    if not plan.indexed:
        return []
    if not cuda:
        print("    [INFO] PyTorch CUDA reconhecido e adiado (é grande e só acelera o Kokoro).")
        for spec, url, source in plan.indexed:
            print(f"           pip install {spec} --index-url {url}")
            print(f"           origem: {source}  —  repita com: python setup.py --cuda")
        return []
    failed: list[str] = []
    for spec, url, _source in plan.indexed:
        ok = _run(
            f"Instalando {spec} (CUDA)",
            [sys.executable, "-m", "pip", "install", "--upgrade", spec, "--index-url", url],
            fatal=False,
        )
        if not ok:
            failed.append(spec)
    return failed


def _install_wake_models() -> bool:
    try:
        if str(HERE) not in sys.path:
            sys.path.insert(0, str(HERE))
        from core.wake_word import install_and_download
    except Exception as exc:
        print(f"    [AVISO] Não foi possível preparar o wake-word: {exc}")
        return False
    ok, message = install_and_download(logger=print)
    if ok:
        print(f"    [OK] {message}")
    else:
