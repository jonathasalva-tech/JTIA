    def _receive_module_result(self, result: dict) -> None:
        self._set_busy(False)
        if not result.get("ok"):
            error = str(result.get("error", _t("Unknown module operation error.")))
            for phrase in (
                "GitHub archive contains too many files for safe analysis.",
                "GitHub archive contains an oversized file.",
                "GitHub archive exceeds the safe extracted size limit.",
                "GitHub archive exceeds the safe download limit.",
                "Repository is too large for safe in-app analysis.",
                "Mark 'Allow large repositories (no size limit)' and analyze again.",
            ):
                if phrase in error:
                    error = error.replace(phrase, _t(phrase))
            self._preview.setPlainText(error)
            self._stage.setText(_t("Stage: task stopped or failed"))
            return
        payload = result.get("payload", {})
        action = payload.get("action")
        text = ""
        if action == "analysis":
            analysis = payload["analysis"]
            self._module_analysis_id = analysis["analysis_id"]
            self._module_install.setEnabled(True)
            repository = analysis["repository"]
            dependencies = ", ".join(analysis["dependencies"][:15])
            risks = "\n- ".join(analysis["risks"])
