    def _publish_github_project(self) -> None:
        name = self._github_repo_name.text().strip() if hasattr(self, "_github_repo_name") else ""
        private = bool(self._github_private.isChecked()) if hasattr(self, "_github_private") else False
        self._github_status_sig.emit(_t("Uploading project to GitHub…"), "busy")
        if hasattr(self, "_github_upload_status"):
            self._github_upload_status.setText(_t("Uploading project to GitHub…"))
            self._github_upload_status.setStyleSheet(
                f"color: {C.ACC2}; background: transparent;"
            )

        def work() -> None:
            try:
                from core.github_account import publish_local_project

                def progress(message: str) -> None:
                    self._github_status_sig.emit(message, "busy")

                published = publish_local_project(
                    name=name,
                    private=private,
                    progress=progress,
                )
                url = published.get("html_url") or ""
                msg = _t(
                    "Uploaded {count} files ({mb} MB) to {repo}."
                ).format(
                    count=published.get("file_count"),
                    mb=published.get("mb"),
                    repo=published.get("full_name"),
                )
                if url:
                    msg = f"{msg}\n{url}"
                self._github_status_sig.emit(
                    _t("Connected as {login}.").format(
                        login=published.get("login") or ""
                    ),
                    "ok",
                )
                self._log_sig.emit(_t("SYS: {message}").format(message=msg.split("\n")[0]))
                # Surface URL/status on the dedicated upload label via status signal kind.
                self._github_upload_done_sig.emit(msg, "ok")
            except Exception as exc:
                message = str(exc)[:220] or type(exc).__name__
                self._github_upload_done_sig.emit(message, "error")
                self._github_status_sig.emit(message, "error")

        threading.Thread(target=work, daemon=True, name="github-project-upload").start()

