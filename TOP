        from core.github_account import clear_github_token
        clear_github_token()
        self._github_token_input.clear()
        self._refresh_github_panel_status()
        self._refresh_github_button()
        self._log_sig.emit(_t("SYS: GitHub token removed."))

    def _attach_github_project(self) -> None:
        start = str(Path.home())
        try:
            from core.github_account import get_attached_project_path
            current = get_attached_project_path()
            if current:
                start = current
        except Exception:
            pass
        selected = QFileDialog.getExistingDirectory(
            self, _t("ATTACH PROJECT FOLDER"), start,
        )
        if not selected:
            return
        try:
            from core.github_account import set_attached_project_path
            set_attached_project_path(selected)
            self._refresh_github_project_label()
            self._log_sig.emit(_t("SYS: GitHub project attached."))
            if hasattr(self, "_github_upload_status"):
                self._github_upload_status.setText(_t("Project attached. Ready to upload."))
                self._github_upload_status.setStyleSheet(
                    f"color: {C.GREEN}; background: transparent;"
                )
            self._refresh_github_panel_status()
        except Exception as exc:
            message = str(exc)[:220] or type(exc).__name__
            if hasattr(self, "_github_project_label"):
                self._github_project_label.setText(message)
                self._github_project_label.setStyleSheet(
                    f"color: {C.RED}; background: transparent;"
                )
            if hasattr(self, "_github_upload_status"):
                self._github_upload_status.setText(message)
                self._github_upload_status.setStyleSheet(
                    f"color: {C.RED}; background: transparent;"
                )

    def _clear_github_project(self) -> None:
        from core.github_account import clear_attached_project_path
        clear_attached_project_path()
        self._refresh_github_project_label()
        if hasattr(self, "_github_upload_status"):
