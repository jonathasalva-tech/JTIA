def _create_desktop_shortcut(target_bat: Path) -> None:
    """Cria atalho na Área de Trabalho do Windows."""
    if OS != "Windows":
        return

    desktop_dir = Path(os.environ.get("USERPROFILE", "")) / "Desktop"
    if not desktop_dir.exists():
        desktop_dir = Path.home() / "Desktop"
    if not desktop_dir.exists():
        print("    [AVISO] Área de Trabalho não localizada para criar atalho.")
        return

    shortcut_path = desktop_dir / "JT.IA.lnk"
    ico_path = HERE / "icone_ia.ico"

    try:
        import win32com.client
        shell = win32com.client.Dispatch("WScript.Shell")
        shortcut = shell.CreateShortCut(str(shortcut_path))
        shortcut.TargetPath = str(target_bat)
        shortcut.WorkingDirectory = str(HERE)
        if ico_path.exists():
            shortcut.IconLocation = str(ico_path)
        shortcut.Description = "Assistente Pessoal Inteligente JT.IA"
        shortcut.Save()
        print(f"    [OK] Atalho criado na Área de Trabalho: {shortcut_path.name}")
        return
    except Exception:
        pass

    try:
        ps_cmd = (
            f"$WshShell = New-Object -comObject WScript.Shell; "
            f"$Shortcut = $WshShell.CreateShortcut('{str(shortcut_path)}'); "
            f"$Shortcut.TargetPath = '{str(target_bat)}'; "
            f"$Shortcut.WorkingDirectory = '{str(HERE)}'; "
            f"$Shortcut.Description = 'Assistente Pessoal Inteligente JT.IA'; "
        )
        if ico_path.exists():
            ps_cmd += f"$Shortcut.IconLocation = '{str(ico_path)}'; "
        ps_cmd += "$Shortcut.Save()"
        res = subprocess.run(["powershell", "-NoProfile", "-Command", ps_cmd], capture_output=True)
        if res.returncode == 0:
            print(f"    [OK] Atalho criado na Área de Trabalho via PowerShell: {shortcut_path.name}")
        else:
            print("    [INFO] Não foi possível criar o atalho automaticamente.")
    except Exception as exc:
        print(f"    [INFO] Criação de atalho ignorada: {exc}")


def _configure_pywin32() -> None:
    """Registra componentes COM e DLLs do pywin32 no Windows."""
    if OS != "Windows":
        return
    scripts_dir = Path(sys.executable).parent / "Scripts"
    postinstall = scripts_dir / "pywin32_postinstall.py"
    if not postinstall.exists():
        postinstall = Path(sys.executable).parent.parent / "Scripts" / "pywin32_postinstall.py"

    if postinstall.exists():
        _run("Registrando extensões pywin32",
             [sys.executable, str(postinstall), "-install"],
             fatal=False)
    else:
        print("    [INFO] Script pywin32_postinstall.py não localizado (instalação padrão ativa).")


def main() -> None:
    parser = argparse.ArgumentParser(description="Instalador Completo do JT.IA")
    parser.add_argument("--minimal", action="store_true",
                        help="Instala apenas as dependências do requirements.txt.")
    parser.add_argument("--dry-run", action="store_true",
                        help="Mostra todos os comandos reconhecidos sem instalar nada.")
    parser.add_argument("--cuda", action="store_true",
                        help="Instala o PyTorch CUDA citado pelo Kokoro (download grande).")
    parser.add_argument("--dev", action="store_true",
                        help="Inclui requirements-dev.txt (pytest).")
    parser.add_argument("--no-browsers", action="store_true",
                        help="Ignora o download dos navegadores Playwright.")
    parser.add_argument("--no-shortcuts", action="store_true",
                        help="Ignora a criação de atalhos e iniciar.bat.")
    parser.add_argument("--no-agent-reach", action="store_true",
                        help="Ignora a instalação editável do módulo agent-reach.")
    parser.add_argument("--no-npm", action="store_true",
                        help="Ignora os comandos npm dos recursos (REA).")
    parser.add_argument("--no-models", action="store_true",
                        help="Ignora o download dos modelos do wake-word.")
    args = parser.parse_args()

    full = not args.minimal
    _print_header("INSTALAÇÃO COMPLETA DO JT.IA — TODOS OS RECURSOS")
    print(f"  Sistema Operacional: {OS or 'Desconhecido'}")
    print(f"  Python Ativo:        {sys.version.split()[0]} ({sys.executable})")
    print(f"  Diretório Raiz:      {HERE}")
    print(f"  Modo:                {'mínimo' if args.minimal else 'completo (todos os recursos)'}")

    _print_step(1, 8, "Verificando versão do Python e compatibilidade")
    _check_python()
    _ensure_directories()

    _print_step(2, 8, "Reconhecendo os comandos de instalação de cada recurso")
    plan = discover_install_plan(include_dev=args.dev and full)
    if args.minimal:
        root_req = HERE / "requirements.txt"
        plan.requirement_files = [root_req] if root_req.is_file() else []
        plan.packages = {}
        plan.editables = {}
        plan.npm_prefixes = {}
        plan.indexed = []
        plan.covered_by_requirements = _names_in_requirement(root_req) if root_req.is_file() else set()
    _print_plan(
        plan,
        cuda=args.cuda,
        browsers=full and not args.no_browsers,
        wake=full and not args.no_models,
    )
    if args.dry_run:
        _print_header("RECONHECIMENTO CONCLUÍDO (nada foi instalado)")
        print("  Execute sem --dry-run para instalar tudo o que foi listado.")
        return

    failures: list[str] = []

    _print_step(3, 8, "Atualizando pip, setuptools e wheel")
    _run("Atualizando gerenciadores de pacotes",
         [sys.executable, "-m", "pip", "install", "--upgrade", "pip", "setuptools", "wheel"],
         fatal=False)

    _print_step(4, 8, "Instalando os arquivos de requisitos reconhecidos")
    if plan.requirement_files:
        _count, req_failed = _install_requirement_files(plan.requirement_files)
        failures.extend(req_failed)
    else:
        print("    [AVISO] Nenhum requirements*.txt encontrado — usando a lista embutida.")
        failures.extend(_install_packages(list(ALL_PACKAGES), "Instalando lista embutida"))
        if OS == "Windows":
            failures.extend(_install_packages(WINDOWS_PACKAGES, "Instalando pacotes Windows"))

    _print_step(5, 8, "Instalando os pacotes que os recursos pedem e que faltam nos requirements")
    if full:
        extras = [
            spec for base, spec in sorted(plan.packages.items())
            if base not in plan.covered_by_requirements
        ]
        failures.extend(_install_packages(
            extras,
            "Instalando pacotes extras reconhecidos (Kokoro, Whisper, soundfile, ...)",
        ))
        if OS == "Windows":
            failures.extend(_install_packages(
                WINDOWS_PACKAGES,
                "Garantindo módulos exclusivos do Windows",
            ))
        failures.extend(_install_indexed(plan, cuda=args.cuda))
    else:
        print("    [INFO] Modo --minimal: extras, OCR/WinRT e voz offline ignorados.")

    _print_step(6, 8, "Instalando recursos locais (Agent-Reach, REA e navegadores)")
    if full:
        failures.extend(_install_editables(plan, enabled=not args.no_agent_reach))
        failures.extend(_install_npm(plan, enabled=not args.no_npm))
        if not args.no_browsers:
            ok = _run(
                "Baixando binários dos navegadores Playwright",
                [sys.executable, "-m", "playwright", "install", "chromium", "firefox"],
                fatal=False,
            )
            if not ok:
                failures.append("playwright browsers")
                print("    Você pode tentar novamente mais tarde com:")
                print(f"      {sys.executable} -m playwright install chromium firefox")
        else:
            print("    [INFO] Download do Playwright ignorado (--no-browsers).")
    else:
        print("    [INFO] Modo --minimal: Agent-Reach, npm e navegadores ignorados.")

    _print_step(7, 8, "Baixando modelos locais e registrando o Windows")
    if full and not args.no_models:
        if not _install_wake_models():
            failures.append("wake-word models")
    elif full:
        print("    [INFO] Modelos do wake-word ignorados (--no-models).")
    else:
        print("    [INFO] Modo --minimal: modelos ignorados.")
    if OS == "Windows":
        _configure_pywin32()
    _check_assets()

    _print_step(8, 8, "Criando atalhos de inicialização")
    if not args.no_shortcuts:
        bat_file = _create_iniciar_bat()
        if OS == "Windows":
            _create_desktop_shortcut(bat_file)
    else:
        print("    [INFO] Atalhos ignorados (--no-shortcuts).")

    if failures:
        _print_header("INSTALAÇÃO CONCLUÍDA COM PENDÊNCIAS")
        print("  Estes itens foram reconhecidos, mas a instalação falhou:")
        for item in failures:
            print(f"    - {item}")
        print("\n  Rode o setup de novo depois de corrigir a rede ou o pacote indicado.")
        sys.exit(1)

    _print_header("INSTALAÇÃO CONCLUÍDA COM SUCESSO!")
    print("""
  Recursos cobertos pelos comandos reconhecidos:
    [OK] Núcleo JT.IA, Interface Gráfica HUD e Gemini Live
    [OK] Visão local, OCR WinRT e Claude Overlay
