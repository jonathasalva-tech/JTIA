    def _save_github_token(self) -> None:
        token = self._github_token_input.text().strip()
        self._github_status_sig.emit(_t("Checking the token with GitHub…"), "busy")

        def work() -> None:
            try:
                from core.github_account import save_github_token
                profile = save_github_token(token)
                login = str(profile.get("login") or "")
                self._github_status_sig.emit(
                    _t("Connected as {login}.").format(login=login), "ok",
                )
                self._log_sig.emit(
                    _t("SYS: GitHub connected as {login}.").format(login=login)
                )
            except Exception as exc:
                message = str(exc)[:180] or type(exc).__name__
                self._github_status_sig.emit(message, "error")

        threading.Thread(target=work, daemon=True, name="github-token-save").start()

