    def _refresh_github_project_label(self) -> None:
        if not hasattr(self, "_github_project_label"):
            return
        from core.github_account import get_attached_project_path
        attached = get_attached_project_path()
        if not attached:
            self._github_project_label.setText(_t("No project attached."))
            self._github_project_label.setStyleSheet(
                f"color: {C.TEXT_DIM}; background: transparent;"
            )
            return
        self._github_project_label.setText(
            _t("{path}\nMeasuring project size…").format(path=attached)
        )
        self._github_project_label.setStyleSheet(
            f"color: {C.ACC2}; background: transparent;"
        )

        def work() -> None:
            try:
                from core.github_account import project_upload_summary
                summary = project_upload_summary(attached)
                self._github_project_summary_sig.emit(summary, "")
            except Exception as exc:
                self._github_project_summary_sig.emit(None, str(exc)[:220])

        threading.Thread(target=work, daemon=True, name="github-project-summary").start()

